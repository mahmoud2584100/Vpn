# Required for Docker Compose: a DNS name only, without https:// or a path.
PUBLIC_HOST=vpn.example.com
# Replace this before deployment. Never commit .env.
ADMIN_PASSWORD=
PORT=8080
DATA_DIR=/data
# Optional when running outside Compose:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_IDS=123456789
# TCP_CONNECT_TIMEOUT=15
# XHTTP_SESSION_IDLE_TIMEOUT=300
# XHTTP_REAPER_INTERVAL=15
