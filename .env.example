# blitz.cloud
PORT=8080
DATA_DIR=/data

# Optional: set this if links/subscription URLs are generated outside a request.
# Otherwise the app uses the incoming Host/X-Forwarded-Host.
# PUBLIC_HOST=your-app.yourname.blitz.cloud

# Required only if you use Telegram management:
# TELEGRAM_BOT_TOKEN=

# Strongly recommended for the dashboard:
# ADMIN_PASSWORD=change-this-to-a-long-random-password

# Optional transport tuning:
# TCP_CONNECT_TIMEOUT=15
# XHTTP_SESSION_IDLE_TIMEOUT=120
# XHTTP_REAPER_INTERVAL=15
